# ---------- Required ----------
# Random secret, at least 32 characters. MUST be identical to the backend's SESSION_SECRET.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# URL of the Lirava backend (server-side only; never exposed to browsers)
BACKEND_URL=http://localhost:4000
# PostgreSQL (the same database the backend uses)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# ---------- Sign-up gate (matches the backend; the backend is the authority) ----------
# Invite codes win over domains. Leave both empty only if you accept open registration.
# SIGNUP_INVITE_CODES=pilot-2026-xxxx
# SIGNUP_ALLOWED_DOMAINS=firm.com
# Comma separated; shown the admin role at signup (the backend decides)
# ADMIN_EMAILS=partner@firm.com

# ---------- Optional ----------
# Public address of the site, used for the sitemap
# NEXT_PUBLIC_SITE_URL=https://app.example.com
# Longest the web app waits for one backend call, in milliseconds (a reply can take a while)
# BACKEND_TIMEOUT_MS=150000
